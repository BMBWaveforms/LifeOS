# Copy to .env.compose in the repository root; retain the same project name for updates.
COMPOSE_PROJECT_NAME=lifeos-team
# Host-side JSON config, mounted read-only as a secret; no API key belongs in this file.
API_CONFIG_PATH=./api.json
WEB_PORT=8780
ALLOWED_ORIGINS=http://localhost:8780,http://127.0.0.1:8780
COOKIE_SECURE=false
