# 本地启动时先复制为 .env，填写绝对路径；Docker 使用 compose 中的 secret。
API_CONFIG_FILE=/absolute/path/to/苟活/api.json
# 可选覆盖 api.json 中的字段；不要在前端维护这些值。
# MODEL_BASE_URL=https://api.deepseek.com/v1
# MODEL_NAME=deepseek-v4-flash
ALLOWED_ORIGINS=http://localhost:8780,http://127.0.0.1:8780
COOKIE_SECURE=false
# Product and workbench always use Claude Agent SDK.
# SDK uses Anthropic-compatible API; summaries/home still use the original API config.
AGENT_SDK_BASE_URL=https://api.deepseek.com/anthropic
# SDK owns chat history; business facts and question status remain in SQLite.
AGENT_SDK_AUTO_COMPACT=true
AGENT_SDK_COMPACT_PCT=60
# Private SDK conversations expire after 7 days, at most 30 per owner runtime directory.
AGENT_SDK_SESSION_TTL_SECONDS=604800
AGENT_SDK_MAX_SESSIONS=30
# Optional numeric context usage observation; leave off for incompatible model providers.
AGENT_SDK_CONTEXT_USAGE=false
# Set privately to provision test1 through test10 with this shared test password.
TEST_ACCOUNT_PASSWORD=
