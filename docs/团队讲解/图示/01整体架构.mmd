flowchart TB
  U["用户浏览器"]
  F["独立前端<br/>静态页面与 API 转发"]
  API["FastAPI<br/>身份验证与接口"]
  O["AgentService<br/>问答、摘要、回访编排"]
  T["只读指南工具<br/>完整回读与结果校验"]
  G["固定指南 JSON<br/>687 个完整条目"]
  M["远程 DeepSeek API<br/>理解、选择、摘要"]
  S["Store<br/>记忆、用户归属、版本"]
  D["SQLite<br/>长期摘要与问题进展"]
  P["独立提示词与工具定义<br/>prompts/ 文件"]
  K["后端私有凭据<br/>不进入前端"]
  U --> F
  F --> API
  API --> O
  O --> T
  T --> G
  O --> M
  O --> S
  S --> D
  P -.-> O
  K -.-> M
  classDef system fill:#edf5ef,stroke:#2b6349,color:#20362c,stroke-width:2px
  class U,F,API,O,T,S system
  classDef model fill:#eaf1fa,stroke:#3a6692,color:#20362c,stroke-width:2px
  class M model
  classDef store fill:#fff5e2,stroke:#9a6b25,color:#20362c,stroke-width:2px
  class G,D store
  classDef decision fill:#f2eef9,stroke:#73578f,color:#20362c,stroke-width:2px
  classDef error fill:#fff0ee,stroke:#a35244,color:#20362c,stroke-width:2px
  classDef neutral fill:#f3f5f6,stroke:#637279,color:#20362c,stroke-width:2px
  class P,K neutral
